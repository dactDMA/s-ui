+<script setup lang="ts">
+import { computed } from 'vue'
+import Headers from '@/components/Headers.vue'
+import { i18n } from '@/locales'
+import type { MasqueradeConfig, MasqueradeOptions } from '@/types/inbounds'
+
+withDefaults(defineProps<{
+  title: string
+  simpleLabel: string
+  minStatus?: number
+}>(), { minStatus: 200 })
+
+const config = defineModel<MasqueradeConfig>()
+const masqTypes = [
+  { title: i18n.global.t('rule.simple'), value: '' },
+  { title: 'File server', value: 'file' },
+  { title: 'Reverse Proxy', value: 'proxy' },
+  { title: 'Fixed response', value: 'string' },
